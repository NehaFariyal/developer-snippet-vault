# ==========================================
# DEVELOPER SNIPPET VAULT & AI PUBLISHER
# Environment Variables Configuration
# ==========================================

# 1. Google Gemini API Key (Required for live Gemini AI Auto-Tagging & Summarization)
# Obtain your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Session Secret for JWT Authentication (Required for signing auth cookies)
# Generate any random string or 32-character key
AUTH_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# 3. Database URL (Optional for local dev, Recommended for Vercel production)
# Leave blank to use durable local storage (.data/vault.json)
# Or provide PostgreSQL / Neon / Supabase connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
